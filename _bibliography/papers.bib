@article{kiendrebeogo2026energy,
  bibtex_show={true},
  kind={working papers},
  title={Optimal Monetary Policy Response to Energy Price Shocks: {Evidence} from the 2022 {Russia--Ukraine} Episode},
  author={Youssouf Kiendrebeogo},
  year={current},
  journal={Working Paper},
  abstract={Energy expenditure is sharply regressive in income: households in the bottom quintile allocate more than twice the budget share to energy as those in the top quintile, in both the United States and the Euro Area. We embed this distributional fact into a Heterogeneous-Agent New Keynesian (HANK) model and derive the Ramsey-optimal monetary policy response to an energy price shock. The optimal rule prescribes less tightening than the Representative-Agent New Keynesian (RANK) benchmark, with a negative correction proportional to the product of the hand-to-mouth consumption share and the quintile expenditure gradient. The ECB should undershoot by more than the Fed in proportion to the steeper European gradient. We confirm these predictions using the 2022 Russia--Ukraine energy shock. Both the Fed and the ECB set rates below their RANK benchmarks throughout the tightening cycle, with Taylor rule residuals of -2.28 pp (Fed) and -2.99 pp (ECB) at twelve months after shock onset, and a significantly positive cross-country slope. The cross-country residual ratio (1.309) lies within 0.003 of the structural prediction (1.312). A formal Wald test rejects precise proportionality over the full tightening path, attributable to the ECB's institutional adjustment lag. A full Bewley--Huggett--Aiyagari welfare analysis finds consumption-equivalent variation gaps of 0.81 pp (United States) and 1.36 pp (Euro Area). In the Euro Area, the bottom two quintiles register absolute welfare gains under optimal policy --- genuine progressive redistribution absent from representative-agent benchmarks. Standard Taylor rules therefore systematically over-prescribe tightening during commodity shocks in heterogeneous-agent economies.},
  pdf={optimal_mp_energy_shocks.pdf},
  html={https://ykiendrebeogo.github.io/assets/pdf/optimal_mp_energy_shocks.pdf},
}

@article{kiendrebeogo2026hulten,
  bibtex_show={true},
  kind={working papers},
  title={Beyond {Hulten}: {AI} and the Open-Economy Input-Output Decomposition},
  author={Youssouf Kiendrebeogo},
  year={current},
  journal={Working Paper},
  abstract={This paper quantifies the aggregate productivity consequences of artificial intelligence in a 77-economy general equilibrium model calibrated to OECD Inter-Country Input-Output tables. Extending Baqaee and Farhi (2019) to an open economy with Armington (1969) preferences and a task-based AI microfoundation, we derive three formal propositions and a five-component welfare decomposition. Under simultaneous global adoption, advanced economies gain 2.35 percentage points per year in labor productivity --- 2.5 times the 0.93 pp/yr closed-economy baseline --- while emerging markets and developing economies gain 1.33 and 0.85 pp/yr, respectively. The international input-output spillover dominates the terms-of-trade penalty by 1.3 to 4.2 times across all 77 economies, guaranteeing a positive net open-economy gain everywhere. Digital trade liberalization adds 0.122 pp/yr for advanced economies at zero additional technology cost. The closed-economy benchmark is not a conservative lower bound but a structurally misleading baseline.},
  pdf={AI-Productivity-Trade.pdf},
  html={https://ykiendrebeogo.github.io/assets/pdf/AI-Productivity-Trade.pdf},
}

