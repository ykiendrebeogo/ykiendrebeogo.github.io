---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<style>
  .btn-theme {
    color: var(--global-text-color) !important;
    border: 1px solid var(--global-text-color) !important;
    background-color: transparent !important;
  }
  .btn-theme:hover {
    color: var(--global-theme-color) !important;
    border-color: var(--global-theme-color) !important;
    background-color: transparent !important;
    box-shadow: none !important;
    text-decoration: none !important;
  }
  .text-theme {
    color: var(--global-theme-color) !important;
  }
  .btn-text-theme {
    color: var(--global-text-color) !important;
  }
  .btn-text-theme:hover {
    color: var(--global-theme-color) !important;
    text-decoration: none !important;
  }
</style>

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  <article>
    <div class="row">
      <!-- Main Content (Description) -->
      <div class="col-md-8">
        {{ content }}
      </div>

      <!-- Sidebar (Info Card) -->
      <div class="col-md-4">
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-body">
            <h5 class="card-title">Course Info</h5>
            <p class="card-text small text-muted">
              {% if page.course_number %}
                <i class="fas fa-hashtag mr-2"></i> {{ page.course_number }}<br>
              {% endif %}
              <i class="fas fa-calendar-alt mr-2"></i> {{ page.semester | default: "Spring 2026" }}<br>
              <i class="fas fa-clock mr-2"></i> {{ page.time | default: "Thu, 14:20-17:20" }}<br>
              <i class="fas fa-map-marker-alt mr-2"></i> {{ page.location | default: "TSMC Bldg. R406" }}
            </p>
            
            {% if page.syllabus %}
              <div class="syllabus-section mt-3">
                {% if page.syllabus contains '.pdf' %}
                  <a href="{{ page.syllabus | relative_url }}#toolbar=0&navpanes=0" class="btn btn-outline-secondary btn-block z-depth-0 btn-theme" target="_blank" rel="noopener noreferrer">
                    <i class="fas fa-eye"></i> View Syllabus
                  </a>
                {% else %}
                  <div class="syllabus-content">
                    {{ page.syllabus | markdownify }}
                  </div>
                {% endif %}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>

    <!-- Feature Grid (Highlights/Toolkit) -->
    {% if page.features %}
      <div class="feature-grid mb-5">
        <h3 class="mb-4">Course Highlights</h3>
        <div class="row">
          {% for feature in page.features %}
            <div class="col-md-4 mb-3">
              <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center">
                  <div class="feature-icon mb-3">
                    {% if feature.icon_svg %}
                      {% include icons/{{ feature.icon_svg }}.svg %}
                    {% else %}
                      <i class="{{ feature.icon }} fa-2x text-theme"></i>
                    {% endif %}
                  </div>
                  <h5 class="card-title">{{ feature.title }}</h5>
                  <p class="card-text small text-muted">{{ feature.description }}</p>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
      <hr>
    {% endif %}

    <!-- Course Materials -->
    {% if page.materials %}
      <h3>Lecture Materials</h3>
      <div class="materials-list">
        <ul>
          {% for item in page.materials %}
            <li>
              <div class="row">
                <div class="col-sm-10">
                  <span class="material-title">{{ item.title }}</span>
                </div>
                <div class="col-sm-2 text-right">
                  {% if item.url %}
                  <a href="{{ item.url | relative_url }}#toolbar=0&navpanes=0" target="_blank" class="btn btn-sm z-depth-0 btn-text-theme" role="button" rel="noopener noreferrer" data-toggle="tooltip" title="View PDF">
                    <i class="fas fa-eye"></i> View
                  </a>
                  {% endif %}
                </div>
              </div>
            </li>
          {% endfor %}
        </ul>
      </div>
      <hr>
    {% endif %}

    <!-- Student Work / Samples -->
    {% if page.samples %}
      <h3>Student Work</h3>
      <div class="publications">
        <ol class="bibliography">
        {% for item in page.samples %}
          <li>
            <div class="row">
              <div class="col-sm-12">
                <div class="title">{{ item.title }}</div>
                <div class="periodical">{{ item.description }}</div>
                <div class="links">
                  <a href="{{ item.url | relative_url }}#toolbar=0&navpanes=0" class="btn btn-sm z-depth-0 btn-text-theme" role="button" target="_blank" rel="noopener noreferrer">View PDF</a>
                </div>
              </div>
            </div>
          </li>
        {% endfor %}
        </ol>
      </div>
    {% endif %}

    <!-- Video Lectures -->
    {% if page.videos %}
      <h3>Video Lectures</h3>
      <div class="row mt-3">
        {% for video in page.videos %}
        <div class="col-sm-6 mb-4">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
              <h6 class="card-title">{{ video.title }}</h6>
              <div class="embed-responsive embed-responsive-16by9">
                {% assign vid_id = video.id | downcase %}
                {% if vid_id contains 'pl' or vid_id contains 'list=' %}
                  <iframe class="embed-responsive-item" src="https://www.youtube.com/embed/videoseries?list={{ video.id }}" allowfullscreen title="{{ video.title }}"></iframe>
                {% else %}
                  <iframe class="embed-responsive-item" src="https://www.youtube.com/embed/{{ video.id }}" allowfullscreen title="{{ video.title }}"></iframe>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
    {% endif %}

    <!-- Class Photos (Carousel) -->
    {% if page.photos %}
      <hr>
      <h3>Class Photos</h3>
      <div id="classPhotoCarousel" class="carousel slide mt-3 shadow-sm rounded" data-ride="carousel">
        <!-- Indicators -->
        <ol class="carousel-indicators">
          {% for photo in page.photos %}
            <li data-target="#classPhotoCarousel" data-slide-to="{{ forloop.index0 }}" class="{% if forloop.first %}active{% endif %}"></li>
          {% endfor %}
        </ol>

        <!-- Wrapper for slides -->
        <div class="carousel-inner rounded">
          {% for photo in page.photos %}
            <div class="carousel-item {% if forloop.first %}active{% endif %}">
              <img src="{{ photo.url | relative_url }}" class="d-block w-100" alt="{{ photo.caption | default: 'Class Photo' }}" style="max-height: 500px; object-fit: cover;">
              {% if photo.caption %}
                <div class="carousel-caption d-none d-md-block" style="background: rgba(0,0,0,0.5); padding: 10px; border-radius: 5px;">
                  <p class="mb-0">{{ photo.caption }}</p>
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>

        <!-- Controls -->
        <a class="carousel-control-prev" href="#classPhotoCarousel" role="button" data-slide="prev">
          <span class="carousel-control-prev-icon" aria-hidden="true"></span>
          <span class="sr-only">Previous</span>
        </a>
        <a class="carousel-control-next" href="#classPhotoCarousel" role="button" data-slide="next">
          <span class="carousel-control-next-icon" aria-hidden="true"></span>
          <span class="sr-only">Next</span>
        </a>
      </div>
    {% endif %}
  </article>
</div>
