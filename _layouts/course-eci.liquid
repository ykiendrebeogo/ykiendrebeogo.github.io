<!doctype html>
<html lang="{{ site.lang }}">
<head>
  {% include metadata.liquid %}

  <!-- Bootstrap & MDB -->
  <link rel="stylesheet" href="{{ '/assets/css/bootstrap.min.css' | relative_url | bust_file_cache }}">
  <link rel="stylesheet" href="{{ site.third_party_libraries.mdb.url.css }}" integrity="{{ site.third_party_libraries.mdb.integrity.css }}" crossorigin="anonymous">

  <!-- Fonts & Icons -->
  <link defer rel="stylesheet" type="text/css" href="{{ site.third_party_libraries.google_fonts.url.fonts }}">
  <link defer rel="stylesheet" href="{{ '/assets/css/academicons.min.css' | relative_url | bust_file_cache }}">

  <!-- Site Styles (for theme variables) -->
  <link rel="stylesheet" href="{{ '/assets/css/main.css' | relative_url | bust_css_cache }}">

  <!-- Dark Mode -->
  <script src="{{ '/assets/js/theme.js' | relative_url | bust_file_cache }}"></script>
  {% if site.enable_darkmode %}
    <script>initTheme();</script>
  {% endif %}

  <!-- ECI Favicon -->
  <link rel="icon" type="image/png" href="/assets/courses/eci/eci_logo.png">
  <link rel="shortcut icon" type="image/png" href="/assets/courses/eci/eci_logo.png">
  <link rel="apple-touch-icon" href="/assets/courses/eci/eci_logo.png">

  <title>{{ page.title }} · {{ page.semester }}</title>

  <style>
    /* ── Reset: hide main site elements ── */
    body {
      background: var(--global-bg-color) !important;
      margin: 0;
      padding: 0;
    }
    #particles-js { display: none !important; }

    /* ── ECI Navbar ── */
    .eci-navbar {
      background: #2c3e50;
      padding: 0;
      box-shadow: 0 2px 8px rgba(0,0,0,0.15);
      position: sticky;
      top: 0;
      z-index: 1050;
    }
    .eci-navbar .navbar-inner {
      max-width: 960px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 1rem;
    }
    .eci-navbar .site-title {
      color: #fff;
      font-weight: 700;
      font-size: 1.1rem;
      text-decoration: none;
      padding: 14px 0;
      white-space: nowrap;
    }
    .eci-navbar .site-title:hover {
      color: rgba(255,255,255,0.85);
      text-decoration: none;
    }
    .eci-navbar .nav-links {
      display: flex;
      align-items: center;
      gap: 0;
    }
    .eci-navbar .nav-links a {
      color: rgba(255,255,255,0.7);
      padding: 14px 16px;
      text-decoration: none;
      font-size: 0.88rem;
      font-weight: 500;
      transition: color 0.15s, background 0.15s;
      border-bottom: 3px solid transparent;
    }
    .eci-navbar .nav-links a:hover {
      color: #fff;
      background: rgba(255,255,255,0.05);
      text-decoration: none;
    }
    .eci-navbar .nav-links a.active {
      color: #fff;
      border-bottom-color: #b509ac;
    }
    .eci-navbar .nav-links .back-link {
      color: rgba(255,255,255,0.5);
      font-size: 0.8rem;
      border-left: 1px solid rgba(255,255,255,0.15);
      margin-left: 8px;
    }
    .eci-navbar .nav-links .back-link:hover {
      color: rgba(255,255,255,0.8);
    }

    /* ── Mobile hamburger ── */
    .eci-navbar .mobile-toggle {
      display: none;
      background: none;
      border: none;
      color: #fff;
      font-size: 1.4rem;
      cursor: pointer;
      padding: 14px 0;
    }
    @media (max-width: 768px) {
      .eci-navbar .nav-links {
        display: none;
        flex-direction: column;
        width: 100%;
        background: #2c3e50;
      }
      .eci-navbar .nav-links.open {
        display: flex;
      }
      .eci-navbar .nav-links a {
        padding: 12px 20px;
        border-bottom: none;
        border-left: 3px solid transparent;
      }
      .eci-navbar .nav-links a.active {
        border-left-color: #b509ac;
        border-bottom-color: transparent;
      }
      .eci-navbar .navbar-inner {
        flex-wrap: wrap;
      }
      .eci-navbar .mobile-toggle {
        display: block;
      }
    }

    /* ── Main container ── */
    .eci-container {
      max-width: 960px;
      margin: 0 auto;
      padding: 0 1rem;
    }

    /* ── Hero ── */
    .eci-hero {
      padding: 2.5rem 0 2rem;
      border-bottom: 3px solid var(--global-divider-color, #dee2e6);
    }
    .eci-hero h1 {
      font-size: 2.3rem;
      font-weight: 700;
      margin-bottom: 0.4rem;
      color: var(--global-text-color);
    }
    .eci-hero .subtitle {
      font-size: 1.2rem;
      color: var(--global-text-color-light);
      margin-bottom: 0.8rem;
    }
    .eci-hero .meta {
      font-size: 0.9rem;
      color: var(--global-text-color-light);
    }
    .eci-hero .meta span {
      margin-right: 1.5rem;
    }
    .eci-hero .meta i {
      color: var(--global-theme-color);
      width: 1.2em;
      text-align: center;
      margin-right: 0.3em;
    }

    /* ── Course logo ── */
    .eci-logo {
      max-width: 130px;
      height: auto;
      display: block;
      border-radius: 12px;
    }
    @media (max-width: 768px) {
      .eci-logo {
        max-width: 120px;
      }
    }

    /* ── Section panels ── */
    .eci-section {
      display: none;
      padding: 2rem 0;
    }
    .eci-section.active {
      display: block;
    }
    #section-overview {
      padding-top: 0;
    }

    /* ── Overview section spacing ── */
    #section-overview h2 + * {
      margin-top: 0;
    }
    #section-overview h2 {
      margin-top: 2.5rem;
    }
    #section-overview h2:first-child {
      margin-top: 0;
    }

    /* ── Course details grid (homepage) ── */
    .course-details {
      padding: 2rem 0;
      border-bottom: 3px solid var(--global-divider-color, #dee2e6);
    }
    .course-details h2 {
      font-size: 1.4rem;
      font-weight: 700;
      margin-bottom: 1rem;
    }
    .info-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .info-list li {
      padding: 4px 0;
      font-size: 0.95rem;
    }
    .info-list i {
      color: var(--global-theme-color);
      width: 1.4em;
      text-align: center;
      margin-right: 0.4em;
    }

    /* ── Feature cards ── */
    .feature-card {
      text-align: center;
      padding: 1.5rem 1rem;
    }
    .feature-card i {
      color: var(--global-theme-color);
      margin-bottom: 0.8rem;
    }
    .feature-card h5 {
      font-size: 1rem;
      font-weight: 600;
    }
    .feature-card p {
      font-size: 0.85rem;
      color: var(--global-text-color-light);
    }

    /* ── Materials list ── */
    .materials-list {
      list-style: none;
      padding: 0;
    }
    .materials-list li {
      padding: 10px 0;
      border-bottom: 1px solid var(--global-divider-color, #eee);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .materials-list li:last-child {
      border-bottom: none;
    }

    /* ── Blockquotes (notes) ── */
    .eci-section blockquote {
      font-size: 0.9rem;
      padding: 0.8rem 1rem;
      margin: 1rem 0;
      border-left: 3px solid var(--global-theme-color);
      background: var(--global-bg-color-secondary, #f8f9fa);
    }

    /* ── Section dividers (horizontal rules) ── */
    .eci-section hr {
      border: none;
      border-top: 2px solid var(--global-divider-color, #dee2e6);
      margin: 2.5rem 0;
    }

    /* ── Links (force theme color over al-folio defaults) ── */
    body .eci-section a:not(.btn-eci):not(.btn-eci-sm):not(.badge-slides):not(.eci-nav-link):not(.site-title):not(.back-link),
    body .eci-section a:not(.btn-eci):not(.btn-eci-sm):not(.badge-slides):not(.eci-nav-link):not(.site-title):not(.back-link):visited {
      color: var(--global-theme-color) !important;
    }
    /* Override al-folio's em/strong/span text-color inside links */
    body .eci-section a:not(.btn-eci):not(.btn-eci-sm):not(.badge-slides) em,
    body .eci-section a:not(.btn-eci):not(.btn-eci-sm):not(.badge-slides) strong,
    body .eci-section a:not(.btn-eci):not(.btn-eci-sm):not(.badge-slides) span,
    body .eci-section a:not(.btn-eci):not(.btn-eci-sm):not(.badge-slides) i {
      color: inherit !important;
    }
    body .eci-section a:not(.btn-eci):not(.btn-eci-sm):not(.badge-slides):hover {
      text-decoration: underline !important;
    }
    body .eci-section a.badge-slides,
    body .eci-section a.badge-slides:visited {
      color: #fff !important;
    }

    /* ── Schedule badges ── */
    .eci-section .badge-slides {
      display: inline-block;
      font-size: 0.78rem;
      font-weight: 600;
      padding: 2px 8px;
      border-radius: 3px;
      margin-right: 4px;
      vertical-align: middle;
      text-decoration: none;
      background: var(--global-theme-color);
      color: #fff !important;
    }
    .eci-section .badge-slides:hover {
      opacity: 0.85;
      text-decoration: none;
    }
    .eci-section .badge-due {
      color: #e74c3c;
      font-weight: 700;
      font-size: 0.85rem;
      margin-right: 0.2em;
    }
    .eci-section .badge-read {
      color: #2980b9;
      font-weight: 700;
      font-size: 0.85rem;
      margin-right: 0.15em;
    }
    .eci-section .badge-read i {
      margin-right: 0.2em;
      font-size: 0.8rem;
    }

    /* ── Instructor card ── */
    .instructor-card {
      display: flex;
      align-items: flex-start;
      gap: 1.5rem;
      margin-top: 0.5rem;
    }
    .instructor-card img {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      object-fit: cover;
      flex-shrink: 0;
    }
    .instructor-card .instructor-info {
      flex: 1;
    }
    .instructor-card .instructor-info p {
      margin: 0 0 0.3rem 0;
    }
    @media (max-width: 576px) {
      .instructor-card {
        flex-direction: column;
        align-items: center;
        text-align: center;
      }
      .instructor-card .info-list {
        text-align: left;
      }
    }

    /* ── Schedule parts ── */
    .eci-section h3 {
      font-size: 1.2rem;
      font-weight: 600;
      margin-top: 2rem;
      padding-bottom: 0.4rem;
      border-bottom: 2px solid var(--global-theme-color);
    }

    /* ── Schedule deliverables ── */
    .schedule-deliverables {
      margin-top: 0.5rem;
      margin-left: 1.2rem;
      padding: 0.4rem 0 0.2rem 0;
      border-top: 1px dashed #ccc;
      font-size: 0.88rem;
      line-height: 1.8;
      color: var(--global-text-color);
    }
    .schedule-deliverables .badge-due {
      font-size: 0.72rem;
      vertical-align: middle;
    }
    .schedule-deliverables .deliv-icon {
      color: var(--global-theme-color);
      width: 1.2em;
      text-align: center;
      margin-right: 0.3em;
      font-size: 0.85rem;
    }

    /* ── Tables ── */
    .eci-section table {
      width: 100%;
      margin: 1rem 0;
    }
    .eci-section table th {
      background: var(--global-theme-color);
      color: #fff;
      padding: 8px 12px;
      font-size: 0.9rem;
    }
    .eval-content table:first-of-type th:first-child,
    .eval-content table:first-of-type td:first-child {
      width: 24%;
    }
    .eval-content table:first-of-type th:nth-child(2),
    .eval-content table:first-of-type td:nth-child(2) {
      width: 10%;
    }
    .eci-section table td {
      padding: 8px 12px;
      border-bottom: 1px solid var(--global-divider-color, #eee);
      font-size: 0.9rem;
    }

    /* ── Video embed ── */
    .video-card {
      margin-bottom: 1.5rem;
    }
    .video-card h6 {
      margin-bottom: 0.5rem;
      font-weight: 600;
    }

    /* ── Shared TOC layout (used by Schedule & Evaluation) ── */
    .toc-layout {
      display: flex;
      gap: 2rem;
    }
    .toc-nav {
      width: 200px;
      flex-shrink: 0;
      position: sticky;
      top: 70px;
      align-self: flex-start;
      max-height: calc(100vh - 90px);
      overflow-y: auto;
      padding-right: 1rem;
      border-right: 1px solid var(--global-divider-color, #dee2e6);
    }
    .toc-nav-title {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--global-text-color-light);
      margin-bottom: 0.6rem;
    }
    .toc-nav ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .toc-nav li {
      margin-bottom: 0.3rem;
    }
    .toc-nav li a {
      font-size: 0.82rem;
      color: var(--global-text-color-light) !important;
      text-decoration: none;
      display: block;
      padding: 3px 0;
      border-left: 2px solid transparent;
      padding-left: 8px;
      transition: all 0.15s;
    }
    .toc-nav li a:hover {
      color: var(--global-theme-color) !important;
      text-decoration: none !important;
    }
    .toc-nav li a.active {
      color: var(--global-theme-color) !important;
      border-left-color: var(--global-theme-color);
      font-weight: 600;
    }
    .toc-content {
      flex: 1;
      min-width: 0;
    }
    @media (max-width: 768px) {
      .toc-layout {
        flex-direction: column;
      }
      .toc-nav {
        position: static;
        width: 100%;
        max-height: none;
        border-right: none;
        border-bottom: 1px solid var(--global-divider-color, #dee2e6);
        padding-right: 0;
        padding-bottom: 1rem;
        margin-bottom: 1rem;
      }
      .toc-nav ul {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem 1rem;
      }
      .toc-nav li a {
        border-left: none;
        padding-left: 0;
      }
    }
    /* Legacy aliases */
    .eval-layout { display: flex; gap: 2rem; }
    .eval-toc { width: 200px; flex-shrink: 0; position: sticky; top: 70px; align-self: flex-start; max-height: calc(100vh - 90px); overflow-y: auto; padding-right: 1rem; border-right: 1px solid var(--global-divider-color, #dee2e6); }
    .eval-content { flex: 1; min-width: 0; }

    /* ── Footer ── */
    .eci-footer {
      text-align: center;
      padding: 2rem 0;
      margin-top: 2rem;
      border-top: 1px solid var(--global-divider-color, #eee);
      font-size: 0.8rem;
      color: var(--global-text-color-light);
    }
    .eci-footer a {
      color: var(--global-theme-color);
    }

    /* ── Buttons ── */
    .btn-eci {
      color: var(--global-text-color);
      border: 1px solid var(--global-text-color);
      background: transparent;
      padding: 6px 14px;
      font-size: 0.85rem;
      border-radius: 4px;
      text-decoration: none;
      transition: all 0.15s;
    }
    .btn-eci:hover {
      color: var(--global-theme-color);
      border-color: var(--global-theme-color);
      text-decoration: none;
    }
    .btn-eci-sm {
      padding: 3px 10px;
      font-size: 0.8rem;
    }
  </style>
</head>

<body>
  <!-- ════════ ECI Navbar ════════ -->
  <nav class="eci-navbar">
    <div class="navbar-inner">
      <a href="{{ page.url | relative_url }}" class="site-title">{{ page.course_number }} · {{ page.semester }}</a>
      <button class="mobile-toggle" onclick="document.querySelector('.nav-links').classList.toggle('open')">☰</button>
      <div class="nav-links">
        <a href="#overview" class="eci-nav-link active" data-section="overview">Overview</a>
        <a href="#schedule" class="eci-nav-link" data-section="schedule">Schedule</a>
        <a href="#materials" class="eci-nav-link" data-section="materials">Materials</a>
        <a href="#evaluation" class="eci-nav-link" data-section="evaluation">Evaluation</a>
        <a href="#policies" class="eci-nav-link" data-section="policies">Policies</a>
        <a href="{{ '/teaching/' | relative_url }}" class="back-link">← Back</a>
      </div>
    </div>
  </nav>

  <div class="eci-container">

    <!-- ════════ Hero ════════ -->
    <div class="eci-hero">
      <div class="row align-items-center">
        <div class="col-md-8">
          <h1>{{ page.title }}</h1>
          <div class="subtitle">{{ page.description }}</div>
          <div class="meta">
            <span><i class="fas fa-hashtag"></i>{{ page.course_number }}</span>
            <span><i class="fas fa-calendar-alt"></i>{{ page.semester }}</span>
            <span><i class="fas fa-map-marker-alt"></i>{{ page.location }}</span>
            <span><i class="fas fa-calendar-day"></i>{{ page.day }}, {{ page.time }}</span>
          </div>
        </div>
        <div class="col-md-4 mt-3 mt-md-0" style="display:flex; flex-direction:column; align-items:center;">
          {% if page.logo %}
            <img src="{{ page.logo | relative_url }}" alt="{{ page.title }} logo" class="eci-logo">
          {% endif %}
          {% if page.syllabus %}
            <a href="{{ page.syllabus | relative_url }}#toolbar=0&navpanes=0" class="btn-eci btn-eci-sm" target="_blank" rel="noopener noreferrer" style="margin-top: 0.8rem;">
              <i class="fas fa-file-pdf"></i> Syllabus PDF
            </a>
          {% endif %}
        </div>
      </div>
    </div>

    <!-- ════════ OVERVIEW ════════ -->
    <div class="eci-section active" id="section-overview">

      <div class="course-details">
        <div class="row">
          <div class="col-md-8">
            {{ content }}
          </div>
          <div class="col-md-4">
            <h2>Course Details</h2>
            <ul class="info-list">
              {% if page.semester_dates %}
                <li><i class="fas fa-calendar-alt"></i> {{ page.semester_dates }}</li>
              {% endif %}
              <li><i class="fas fa-calendar-day"></i> {{ page.day }}</li>
              <li><i class="fas fa-clock"></i> {{ page.time }}</li>
              <li><i class="fas fa-map-marker-alt"></i> {{ page.location }}</li>
            </ul>
            {% if page.communication %}
              <h2 class="mt-4">Communication</h2>
              <p style="font-size: 0.9rem; line-height: 1.6;">{{ page.communication }}</p>
            {% endif %}
          </div>
        </div>
      </div>

      <!-- Topics Covered -->
      {% if page.features %}
        <div style="padding: 2rem 0;">
          <h2 style="font-size: 1.4rem; font-weight: 700; margin-bottom: 1.5rem;">Topics Covered</h2>
          <div class="row">
            {% for feature in page.features %}
              <div class="col-md-4 mb-3">
                <div class="card h-100 border-0 shadow-sm">
                  <div class="card-body feature-card">
                    <i class="{{ feature.icon }} fa-2x"></i>
                    <h5>{{ feature.title }}</h5>
                    <p>{{ feature.description }}</p>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}

      <!-- Video Lectures -->
      {% if page.videos %}
        <h2 style="font-size: 1.4rem; font-weight: 700; margin-bottom: 1rem;">Video Lectures</h2>
        <div class="row">
          {% for video in page.videos %}
          <div class="col-md-8 video-card">
            <h6>{{ video.title }}</h6>
            <div class="embed-responsive embed-responsive-16by9">
              {% assign vid_id = video.id | downcase %}
              {% if vid_id contains 'pl' or vid_id contains 'list=' %}
                <iframe class="embed-responsive-item" src="https://www.youtube.com/embed/videoseries?list={{ video.id }}" allowfullscreen title="{{ video.title }}"></iframe>
              {% else %}
                <iframe class="embed-responsive-item" src="https://www.youtube.com/embed/{{ video.id }}" allowfullscreen title="{{ video.title }}"></iframe>
              {% endif %}
            </div>
          </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- ════════ SCHEDULE ════════ -->
    <div class="eci-section" id="section-schedule">
      <div class="toc-layout">
        <nav class="toc-nav" id="schedule-toc">
          <div class="toc-nav-title">On this page</div>
          <ul id="schedule-toc-list"></ul>
        </nav>
        <div class="toc-content" id="schedule-content">
          {% if page.schedule_content %}
            {{ page.schedule_content | markdownify }}
          {% else %}
            <p><em>Schedule will be posted before the first class.</em></p>
          {% endif %}
        </div>
      </div>
    </div>

    <!-- ════════ MATERIALS ════════ -->
    <div class="eci-section" id="section-materials">
      {% if page.materials %}
        <h2>Lecture Slides</h2>
        <ul class="materials-list">
          {% for item in page.materials %}
            <li>
              <span>{{ item.title }}</span>
              {% if item.url %}
                <a href="{{ item.url | relative_url }}#toolbar=0&navpanes=0" target="_blank" class="btn-eci btn-eci-sm" rel="noopener noreferrer">
                  <i class="fas fa-eye"></i> View
                </a>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      {% endif %}

      {% if page.textbooks_content %}
        <hr>
        {{ page.textbooks_content | markdownify }}
      {% endif %}
    </div>

    <!-- ════════ EVALUATION ════════ -->
    <div class="eci-section" id="section-evaluation">
      <div class="toc-layout">
        <nav class="toc-nav" id="eval-toc">
          <div class="toc-nav-title">On this page</div>
          <ul id="eval-toc-list"></ul>
        </nav>
        <div class="toc-content" id="eval-content">
          {% if page.assignments_content %}
            {{ page.assignments_content | markdownify }}
          {% else %}
            <p><em>Evaluation details will be posted before the first class.</em></p>
          {% endif %}
        </div>
      </div>
    </div>

    <!-- ════════ POLICIES ════════ -->
    <div class="eci-section" id="section-policies">
      {% if page.policies_content %}
        {{ page.policies_content | markdownify }}
      {% else %}
        <p><em>Please refer to the Syllabus PDF for course policies.</em></p>
      {% endif %}
    </div>

    <!-- Footer -->
    <footer class="eci-footer">
      {{ page.title }} · {{ page.semester }} · <a href="{{ '/teaching/' | relative_url }}">Jaewon Yoo</a> · National Tsing Hua University
    </footer>

  </div>

  <!-- Scripts -->
  <script src="{{ site.third_party_libraries.jquery.url.js }}" integrity="{{ site.third_party_libraries.jquery.integrity.js }}" crossorigin="anonymous"></script>
  <script src="{{ '/assets/js/bootstrap.bundle.min.js' | relative_url }}"></script>
  <script src="{{ site.third_party_libraries.mdb.url.js }}" integrity="{{ site.third_party_libraries.mdb.integrity.js }}" crossorigin="anonymous"></script>

  <script>
  document.addEventListener('DOMContentLoaded', function() {
    var links = document.querySelectorAll('.eci-nav-link');
    var sections = document.querySelectorAll('.eci-section');

    links.forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        var target = this.getAttribute('data-section');

        // Update nav
        links.forEach(function(l) { l.classList.remove('active'); });
        this.classList.add('active');

        // Update sections
        sections.forEach(function(s) { s.classList.remove('active'); });
        var el = document.getElementById('section-' + target);
        if (el) el.classList.add('active');

        // Close mobile menu
        document.querySelector('.nav-links').classList.remove('open');

        // Update URL hash
        history.replaceState(null, null, '#' + target);

        // Scroll to top
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });

    // Handle initial hash
    var hash = window.location.hash.replace('#', '');
    if (hash) {
      var targetLink = document.querySelector('.eci-nav-link[data-section="' + hash + '"]');
      if (targetLink) targetLink.click();
    }

    // ── Shared TOC builder ──
    function buildToc(contentId, tocListId, headingSelector, idPrefix) {
      var content = document.getElementById(contentId);
      var list = document.getElementById(tocListId);
      if (!content || !list) return;
      var headings = content.querySelectorAll(headingSelector);
      headings.forEach(function(h, i) {
        var id = idPrefix + '-' + i;
        h.setAttribute('id', id);
        var li = document.createElement('li');
        var a = document.createElement('a');
        a.href = '#' + id;
        a.textContent = h.textContent;
        a.addEventListener('click', function(e) {
          e.preventDefault();
          h.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
        li.appendChild(a);
        list.appendChild(li);
      });
      var tocLinks = list.querySelectorAll('a');
      window.addEventListener('scroll', function() {
        var activeIdx = 0;
        if ((window.innerHeight + window.scrollY) >= (document.body.scrollHeight - 50)) {
          activeIdx = headings.length - 1;
        } else {
          headings.forEach(function(h, i) {
            var rect = h.getBoundingClientRect();
            if (rect.top <= 120) activeIdx = i;
          });
        }
        tocLinks.forEach(function(a, i) {
          a.classList.toggle('active', i === activeIdx);
        });
      });
    }

    // Schedule TOC: from h3 headings (Part I, II, III, IV)
    buildToc('schedule-content', 'schedule-toc-list', 'h3', 'sched');

    // Evaluation TOC: from h2 headings
    buildToc('eval-content', 'eval-toc-list', 'h2', 'eval');
  });
  </script>
</body>
</html>
