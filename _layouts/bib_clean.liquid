---
---
<div class="entry">
  <div class="entry-content">
    {{ entry.title }}.
    {% for author in entry.author_array -%}
      {%- if author.last == site.scholar.last_name[0] and author.first == site.scholar.first_name[0] -%}
        <b>{{ author.first }} {{ author.last }}</b>
      {%- else -%}
        {{ author.first }} {{ author.last }}
      {%- endif -%}
      {%- unless forloop.last -%}, {% endunless -%}
    {%- endfor -%}.
    {% if entry.journal or entry.booktitle or entry.year != "current" %}
    <em>{{ entry.journal | default: entry.booktitle }}</em>{% if entry.year != "current" %}, {{ entry.year }}{% endif %}.
    {% endif %}
  </div>
</div>
